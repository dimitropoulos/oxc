---
source: crates/oxc_formatter_yaml/tests/fixtures/mod.rs
---
==================== Input ====================
# Comments, anchors, aliases and merge keys in one document, all preserved.
#
# Required by the definition of done. Each hazard refuses its own mapping and nothing else:
# `/ordered` at the bottom has none of them and is reordered, so this fixture also shows that
# the refusals are local.
openapi: 3.0.0
defaults: &defaults
  summary: inherited
  description: inherited description
paths:
  /commented:
    get:
      responses: {}
      # a comment here
      summary: s # and a trailing one
      operationId: op
  /anchored:
    get:
      responses: &shared {}
      summary: s
      operationId: op
  /aliased:
    get:
      responses: *shared
      summary: s
      operationId: op
  /merged:
    get:
      responses: {}
      <<: *defaults
      operationId: op
  /everything:
    get:
      # comment, alias and merge key together
      <<: *defaults
      responses: *shared
      operationId: op
  /ordered:
    get:
      responses: {}
      summary: s
      operationId: op

