==================== Input ====================
# The gate is per document, not per stream. The first document is OpenAPI and is ordered; the
# second is not and is byte-identical; the third is OpenAPI again, proving the gate is re-read
# rather than latched.
---
paths:
  /p:
    get:
      responses: {}
      summary: s
      operationId: op
openapi: 3.0.0
---
paths:
  /p:
    get:
      responses: {}
      summary: s
      operationId: op
---
openapi: 3.0.0
paths:
  /q:
    post:
      responses: {}
      summary: s
      operationId: op

