==================== Input ====================
// Array steps are part of the ancestry.
//
// The policy indexes the ancestry absolutely and treats the containing object as absent across an
// array boundary. `Foo` holds an array, so its element's containing object is the array, not
// `schemas`: the element keeps source order. `parameters` is the shape where both readings agree.
{
  "openapi": "3.0.0",
  "components": { "schemas": { "Foo": [{ "type": "string", "description": "d" }] } },
  "paths": {
    "/p": {
      "get": {
        "responses": {},
        "parameters": [{ "schema": {}, "in": "query", "name": "limit" }],
        "operationId": "op"
      }
    }
  }
}

